# Modelo local via Ollama — sem custo por token, sem chave de API.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Credenciais de um ClientApplication do Medplum (Admin > Client Applications).
# Necessário só para as tools que leem/gravam FHIR (buscar paciente, criar MedicationRequest draft).
MEDPLUM_BASE_URL=https://api.medplum.com
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
