# Groq (LLM) — chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=

# Modelo usado pelos agentes (opcional, este é o default)
GROQ_MODEL=groq/llama-3.3-70b-versatile

# Medplum — servidor MCP (fhir-request)
# Contra o Medplum Cloud, deixe MEDPLUM_BASE_URL como está e ajuste só se
# você usa um projeto self-hosted (ex.: http://localhost:8103).
MEDPLUM_BASE_URL=https://api.medplum.com
# Só defina MEDPLUM_MCP_URL se quiser sobrescrever o padrão
# ({MEDPLUM_BASE_URL}/mcp/stream) — por exemplo, para testar localmente.
# MEDPLUM_MCP_URL=http://localhost:8103/mcp/stream

# ClientApplication do Medplum (Admin > Client Applications) associado a uma
# AccessPolicy SOMENTE LEITURA (Admin > Access Policies). Veja o README.
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=
